{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), gamepad=(self)" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)-games.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/snes", "destination": "/snes.html" },
    { "source": "/snes-player", "destination": "/snes-player.html" },
    { "source": "/ps1", "destination": "/ps1.html" },
    { "source": "/ps1-player", "destination": "/ps1-player.html" },

    { "source": "/api/snes", "destination": "/api/index.js" },
    { "source": "/snes-games.json", "destination": "/api/index.js" },
    { "source": "/api/ps1", "destination": "/api/index.js" },
    { "source": "/ps1-games.json", "destination": "/api/index.js" },
    { "source": "/api/neogeo", "destination": "/api/index.js" },
    { "source": "/neogeo-games.json", "destination": "/api/index.js" },
    { "source": "/api/n64", "destination": "/api/index.js" },
    { "source": "/n64-games.json", "destination": "/api/index.js" },
    { "source": "/api/gameboy", "destination": "/api/index.js" },
    { "source": "/gameboy-games.json", "destination": "/api/index.js" },
    { "source": "/api/sega", "destination": "/api/index.js" },
    { "source": "/sega-games.json", "destination": "/api/index.js" },
    { "source": "/api/psp", "destination": "/api/index.js" },
    { "source": "/psp-games.json", "destination": "/api/index.js" },

    { "source": "/neogeo", "destination": "/api/index.js" },
    { "source": "/neogeo.html", "destination": "/api/index.js" },
    { "source": "/neogeo-player", "destination": "/api/index.js" },
    { "source": "/neogeo-player.html", "destination": "/api/index.js" },

    { "source": "/n64", "destination": "/api/index.js" },
    { "source": "/n64.html", "destination": "/api/index.js" },
    { "source": "/n64-player", "destination": "/api/index.js" },
    { "source": "/n64-player.html", "destination": "/api/index.js" },

    { "source": "/gameboy", "destination": "/api/index.js" },
    { "source": "/gameboy.html", "destination": "/api/index.js" },
    { "source": "/gameboy-player", "destination": "/api/index.js" },
    { "source": "/gameboy-player.html", "destination": "/api/index.js" },

    { "source": "/sega", "destination": "/api/index.js" },
    { "source": "/sega.html", "destination": "/api/index.js" },
    { "source": "/sega-player", "destination": "/api/index.js" },
    { "source": "/sega-player.html", "destination": "/api/index.js" },

    { "source": "/psp", "destination": "/api/index.js" },
    { "source": "/psp.html", "destination": "/api/index.js" },
    { "source": "/psp-player", "destination": "/api/index.js" },
    { "source": "/psp-player.html", "destination": "/api/index.js" }
  ]
}
