{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/snes", "destination": "/api/snes.js" },
    { "source": "/api/ps1", "destination": "/api/ps1.js" },
    { "source": "/api/neogeo", "destination": "/api/neogeo.js" },
    { "source": "/neogeo-games.json", "destination": "/api/neogeo.js" },
    { "source": "/neogeo.html", "destination": "/api/neogeo-page.js" },
    { "source": "/neogeo-player.html", "destination": "/api/neogeo-player-page.js" },
    { "source": "/neogeo", "destination": "/api/neogeo-page.js" },
    { "source": "/neogeo-player", "destination": "/api/neogeo-player-page.js" }
  ]
}
